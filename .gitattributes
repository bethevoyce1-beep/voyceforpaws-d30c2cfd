# Normalize text files to LF in the git repo and let Windows work with CRLF locally.
# Prevents "every file is modified" false positives when the repo lives in Dropbox on Windows.
* text=auto eol=lf

# Explicit for common web source types
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.sh     text eol=lf

# Windows-specific — keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary files — never touch
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.mov    binary
*.mp4    binary
*.zip    binary
