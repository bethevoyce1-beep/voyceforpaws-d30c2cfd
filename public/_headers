# Hashed build assets never change under the same filename — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/_build/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (the HTML shell / routes) must always revalidate so a new
# deploy is picked up immediately instead of being served from a stale cache.
/*
  Cache-Control: no-cache
